# Simulate plots against altitude / Mach / distance (the `VS` selector in the plot header row; saved with the layout).
#   cargo run -q -p bowshock -- drive --example crates/bowshock/scripts/plot-x.drive /tmp/plot-x
viewport 1280x800
scale 2
click (663, 18)
click "Run"
click "Alt"
move (700, 300)
screenshot 01-vs-altitude-dark.png
click "Mach"
move (690, 520)
screenshot 02-vs-mach-dark.png
click "Dist"
screenshot 03-vs-distance-dark.png
click "Light"
click "Alt"
move (650, 300)
screenshot 04-vs-altitude-light.png
