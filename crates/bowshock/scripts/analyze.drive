# The Analyze screen: every analysis, hover, the table view, the light theme and a second configuration.
# Run with the example rocket loaded: `cargo run -q -p bowshock -- drive --example crates/bowshock/scripts/analyze.drive out/analyze`
viewport 1300x800
click "Analyze"
# Pointer away from the plots: the crosshair rests at the flight's maximum Mach and At cursor is filled in.
move (100, 700)
move (102, 702)
screenshot default-cursor.png

# Hover moves the crosshair and the values at the cursor.
move (700, 300)
move (702, 302)
screenshot aerodynamics-hover.png

# The light theme, same screen.
click "Prefs"
click "Light"
click "Done"
move (100, 700)
move (102, 702)
screenshot light.png
click "Prefs"
click "Dark"
click "Done"

# CG for margin: burnout.
click "Burnout"
move (704, 304)
screenshot aerodynamics-burnout.png
click "Liftoff"

click "Stability"
move (500, 300)
move (502, 302)
screenshot stability.png

click "Drag breakdown"
move (500, 300)
move (502, 302)
screenshot drag.png

click "Fin flutter"
move (500, 300)
move (502, 302)
screenshot flutter.png

click "Dispersion"
move (500, 300)
move (502, 302)
screenshot dispersion.png

click "Aerodynamics"
move (500, 300)
move (502, 302)
click "Table view"
screenshot table.png
click "Plots"
screenshot back-to-plots.png

# A second configuration: one margin and CP line per configuration, labelled, with a colour key above the plots; the Cd panel keeps
# the active configuration's stack by source and adds the other's total as a dashed line.
click "CONFIG"
click "New configuration…"
click "I284W"
click "Add configuration"
move (500, 300)
move (502, 302)
screenshot compare-aero.png
click "Dispersion"
move (500, 300)
move (502, 302)
screenshot compare-dispersion.png
